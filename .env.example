# === The Warden — environment ===
# Copy to .env and fill in. Never commit the real .env.

# Fresh BotFather identity. Username is stored WITHOUT the @.
BOT_USERNAME=RiftWardenBot
BOT_PUBLIC_URL=https://t.me/RiftWardenBot

# From BotFather. Treat this like a password — anyone with it controls the bot.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (not your @username). Get it from @userinfobot.
#
# This unlocks Boss-only global commands and identifies @aussieboomer securely.
# Extra-bot and trust-level authority is shared with TREEFITTY_USER_ID below.
# Usernames are never accepted as proof of authority.
#
# SET THIS. Without it Boss-only powers are disabled (fail closed).
GLOBAL_OWNER_USER_ID=

# Numeric Telegram IDs for the fixed launch team. Usernames are display-only; permissions use IDs.
TREEFITTY_USER_ID=
DAVEYJON_USER_ID=
RAINZY_USER_ID=

# Optional public project links. Leave blank until the fresh URLs are final.
OFFICIAL_WEBSITE_URL=
OFFICIAL_TELEGRAM_URL=

# Optional owner/contact username, WITHOUT @. Used only in human-facing text.
OWNER_CONTACT_USERNAME=

# Optional comma-separated official domains for anti-typosquat checks.
# Example: OFFICIAL_DOMAINS=example.com,www.example.com
OFFICIAL_DOMAINS=

# Comma-separated official Base/EVM contract addresses that trusted mods may post.
# If blank, trusted-mod contract-address posts are held.
OFFICIAL_CONTRACT_ADDRESSES=

# Postgres connection string. Use a POOLED serverless connection.
DATABASE_URL=

# OpenAI-compatible endpoint used for AI replies.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Random long string. Signs admin portal login sessions.
SESSION_SECRET=

# Trust-level changes are hard restricted to GLOBAL_OWNER_USER_ID and TREEFITTY_USER_ID.

# === VERCEL / SERVERLESS ===
# Durable state. WITHOUT THESE THE BOT WILL REFUSE TO START on Vercel, because
# warning counts, mute escalation and raid lockdowns would silently reset on
# every cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fresh deployed bot backend URL, e.g. https://rift-warden.vercel.app
PUBLIC_URL=

# Optional override if Rift Radio is ever hosted separately. Leave blank to use PUBLIC_URL/rift-radio.html.
RIFT_RADIO_URL=

# Random string. Telegram sends it with every update so nobody else can
# post fake messages to your webhook.
TELEGRAM_WEBHOOK_SECRET=

# Random string. Guards /api/set-webhook so nobody can repoint your bot.
SETUP_KEY=

# Set by Vercel automatically when you add a cron job. Guards /api/cron.
CRON_SECRET=

# Local timezone for scheduled community events (birthdays, quotes, etc.)
COMMUNITY_TIMEZONE=Australia/Hobart
